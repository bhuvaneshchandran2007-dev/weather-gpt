# WeatherGPT Backend Environment Variables
# SIH Problem Statement 26068 (MoES / IMD)
# Store secrets ONLY in backend environment variables. Never expose in frontend.

# Visual Crossing / OpenWeather API Key
# Replace with your actual key from Visual Crossing or OpenWeather
WEATHER_API_KEY=YOUR_WEATHER_API_KEY_HERE
OPENWEATHER_API_KEY=YOUR_OPENWEATHER_API_KEY_HERE

# Optional: Google Maps Platform API Key (for Google Maps JavaScript API)
# If left empty, WeatherGPT seamlessly activates the Leaflet / OpenStreetMap GIS engine.
GOOGLE_MAPS_API_KEY=

# Optional: Gemini API Key (for conversational AI augmentation)
# If left empty, WeatherGPT's built-in Meteorological Reasoning Agent handles intent, tools, reasoning, and multilingual synthesis locally.
GEMINI_API_KEY=

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=true

# Cache TTL in seconds (to prevent hammering API rate limits)
CACHE_TTL_SECONDS=600
